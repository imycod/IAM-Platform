# docker compose 环境变量示例（复制为 .env.docker 后修改）
# cp .env.docker.example .env.docker

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=iam
MYSQL_PUBLISH_PORT=3308

# Redis
REDIS_PUBLISH_PORT=6380

# IAM 服务
APP_PORT=3000
IAM_PUBLISH_PORT=3000

DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=iam

# OIDC / SSO（NAS：admin 反代 /oidc，issuer 与前端访问源一致，如 :9446）
APP_URL=http://192.168.50.100:9446
BETTER_AUTH_SECRET=please-change-me-in-production
BETTER_AUTH_URL=http://192.168.50.100:9446
OIDC_ISSUER=http://192.168.50.100:9446/oidc
OIDC_COOKIE_KEYS=dev-key-1,dev-key-2
OIDC_SESSION_TTL_SECONDS=1209600

# 使用 Nginx 网关 profile 时改为子域（需 hosts + docker compose --profile gateway）
# APP_URL=http://api.pinshuai.local
# BETTER_AUTH_URL=http://api.pinshuai.local
# OIDC_ISSUER=http://auth.pinshuai.local/oidc
# NGINX_PUBLISH_PORT=80

# 首次启动后可在容器内执行 seed（示例）：
# docker compose --env-file .env.docker exec iam pnpm seed:oauth-flow-admin
