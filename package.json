{
  "name": "iam-platform",
  "version": "0.1.0",
  "description": "IAM Platform - NestJS + TypeORM + MySQL Monorepo",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:iam": "nest build iam && node scripts/stage-iam-dist.js",
    "build:iam-admin": "npm run build --prefix apps/iam-admin",
    "start:iam": "nest start iam",
    "start:iam:dev": "cross-env NODE_ENV=development nest start iam --watch",
    "start:iam:prod": "cross-env NODE_ENV=production node dist/apps/iam/src/main",
    "start:iam:dev:stage": "cross-env NODE_ENV=stage nest start iam --watch",
    "dev:iam:stage": "node run-nginx.js",
    "start:iam:debug": "cross-env NODE_ENV=development nest start iam --debug 9229 --watch",
    "start:iam:debug:stage": "cross-env NODE_ENV=stage nest start iam --debug 9229 --watch",
    "start:iam:dev:nginx": "pnpm run start:iam:dev:stage",
    "dev:iam:nginx": "pnpm run dev:iam:stage",
    "start:iam:debug:nginx": "pnpm run start:iam:debug:stage",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/iam/src/database/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate apps/iam/src/database/migrations/Migration",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "schema:log": "pnpm typeorm schema:log",
    "seed": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/index.ts",
    "seed:flow-admin-user": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/flow-admin-data.ts",
    "seed:create-account": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/create-account-data.ts",
    "seed:oauth-flow-admin": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/oauth-flow-admin.ts",
    "seed:flow-admin-access": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/flow-admin-access-data.ts",
    "seed:iam-admin": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/iam-admin-data.ts",
    "seed:iam-admin-application": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/iam-admin-application-data.ts",
    "seed:iam-admin-identity": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/iam-admin-identity-data.ts",
    "seed:iam-admin-organization": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/iam-admin-organization-data.ts",
    "seed:iam-admin-security": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/iam-admin-security-data.ts",
    "seed:assign-iam-admin-admin": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/assign-iam-admin-admin-role.ts",
    "seed:oauth-iam-admin": "ts-node -r tsconfig-paths/register apps/iam/src/database/seeds/oauth-iam-admin.ts",
    "flow-admin:dev": "node apps/flow-admin/server.js"
  },
  "dependencies": {
    "@casl/ability": "^6.7.2",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "mysql2": "^3.11.3",
    "oidc-provider": "^8.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.10",
    "@types/oidc-provider": "^8.5.2",
    "cross-env": "^10.1.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
