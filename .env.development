# 登录/consent UI 现由 IAM 后端在同源 /api/interaction/:uid 渲染（localhost 下即 http://localhost:3000）。
# 不再需要独立的 IAM_LOGIN_URL（node-oidc-provider 的 _interaction cookie 因此按 uid 路径隔离）。

APP_URL=http://localhost:3000

# better-auth (后续接入)
BETTER_AUTH_SECRET=please-change-me
BETTER_AUTH_URL=http://localhost:3000

# OIDC
OIDC_ISSUER=http://localhost:3000/oidc
OIDC_COOKIE_KEYS=key1,key2
# 显式 RSA JWKS（私钥）。也可用 OIDC_JWKS='{"keys":[...]}' 内联。
# 生成：pnpm oidc:jwks:generate
# 轮换：pnpm oidc:jwks:rotate → 重启 → pnpm oidc:jwks:promote → 再重启
OIDC_JWKS_FILE=secrets/oidc-jwks.json
OIDC_SESSION_TTL_SECONDS=2592000
OIDC_ACCESS_TOKEN_TTL_SECONDS=7200
OIDC_REFRESH_TOKEN_TTL_SECONDS=2592000
PORTAL_SESSION_TTL_SECONDS=604800
OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
