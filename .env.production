# 生产环境（NODE_ENV=production 时加载，优先于 .env）
# 业务域名与密钥由部署注入（Docker/K8s/CI），勿在仓库写死。
# 子域约定与前端 config.js 一致：api.<root> / auth.<root> / admin.<root>
#
# 部署时设置（示例）：
#   APP_URL=https://api.example.com
#   BETTER_AUTH_URL=https://api.example.com
#   BETTER_AUTH_SECRET=<secret>
#   OIDC_ISSUER=https://auth.example.com/oidc
#   OIDC_COOKIE_KEYS=<key1,key2>
#   DB_* / REDIS_* 同理由运行环境提供

IAM_INTERACTION_UI_DIR=/app/dist/apps/iam/assets/interaction
