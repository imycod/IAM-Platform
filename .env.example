# 复制为 .env 后按环境修改；上线用 .env.production 覆盖

APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
APP_GLOBAL_PREFIX=api

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=iam

REDIS_HOST=localhost
REDIS_PORT=6379

OIDC_ISSUER=http://localhost:3000/oidc
OIDC_COOKIE_KEYS=change-me-1,change-me-2
OIDC_SESSION_TTL_SECONDS=1209600

# 生产请改为 auth 域，与 OIDC_ISSUER 同源
IAM_LOGIN_URL=http://localhost:4180
IAM_LOGIN_PORT=4180

CORS_ORIGINS=http://localhost:8088,http://localhost:8089,http://localhost:4180

APP_RETURN_URLS={"iam-admin-spa":"http://localhost:8088/","flow-admin-spa":"http://localhost:8089/"}
