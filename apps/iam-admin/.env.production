# 线上环境平台打包路径
VITE_PUBLIC_PATH=/

# 线上环境路由历史模式
VITE_ROUTER_HISTORY=hash

# 是否在打包时使用cdn替换本地库
VITE_CDN=false

# 压缩：none | gzip | brotli | both | *-clear
VITE_COMPRESSION=none

# OIDC / IAM（生产：auth=IdP，api=业务）
VITE_IAM_BASE_URL=http://api.pinshuai.local
VITE_OIDC_ISSUER=http://auth.pinshuai.local/oidc
VITE_OIDC_CLIENT_ID=iam-admin-spa
VITE_OIDC_SCOPES=openid profile email
VITE_APP_CODE=iam-admin
