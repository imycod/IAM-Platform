{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "IAM: start:dev:nginx (debug)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start:debug:nginx"],
      "cwd": "${workspaceFolder}/IAM-Platform",
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "outFiles": ["${workspaceFolder}/IAM-Platform/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "IAM: attach (9229)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/IAM-Platform",
      "outFiles": ["${workspaceFolder}/IAM-Platform/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "flow-admin backend: dev (debug)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start:debug"],
      "cwd": "${workspaceFolder}/flow-admin/backend",
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "preLaunchTask": "flow-admin: build shared",
      "outFiles": ["${workspaceFolder}/flow-admin/backend/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "flow-admin backend: attach (9229)",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/flow-admin/backend",
      "outFiles": ["${workspaceFolder}/flow-admin/backend/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "flow-admin backend: attach (9230)",
      "port": 9230,
      "restart": true,
      "sourceMaps": true,
      "cwd": "${workspaceFolder}/flow-admin/backend",
      "outFiles": ["${workspaceFolder}/flow-admin/backend/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "flow-admin backend: dev (debug, port 9230)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start:debug:9230"],
      "cwd": "${workspaceFolder}/flow-admin/backend",
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "autoAttachChildProcesses": true,
      "preLaunchTask": "flow-admin: build shared",
      "outFiles": ["${workspaceFolder}/flow-admin/backend/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "IAM + flow-admin backend (debug)",
      "configurations": [
        "IAM: start:dev:nginx (debug)",
        "flow-admin backend: dev (debug, port 9230)"
      ],
      "stopAll": true
    }
  ]
}
