# App
APP_NAME=iam
APP_PORT=3000
NODE_ENV=development
APP_GLOBAL_PREFIX=api

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=iam

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 会话 TTL（秒）— 与 libs/config auth-session 生产默认一致；管理台可覆盖 OIDC/门户全局项
# OIDC SSO Session / Grant / Interaction：2592000（30 天）
OIDC_SESSION_TTL_SECONDS=2592000
# OIDC AccessToken / IdToken：7200（2 小时）
OIDC_ACCESS_TOKEN_TTL_SECONDS=7200
# OIDC RefreshToken：2592000（30 天），须 ≥ access
OIDC_REFRESH_TOKEN_TTL_SECONDS=2592000
# 账密门户 session（滑动续期）：604800（7 天）
PORTAL_SESSION_TTL_SECONDS=604800
# OIDC 授权码：300（5 分钟）
OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
