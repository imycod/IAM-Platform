# docker compose 环境变量示例（复制为 .env.docker 后修改）
# cp .env.docker.example .env.docker

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=iam
MYSQL_PUBLISH_PORT=3308

# Redis
REDIS_PUBLISH_PORT=6380

# IAM 服务
APP_PORT=3000
IAM_PUBLISH_PORT=3000

# iam-admin 前端（Nginx 静态，/api 反代到 iam 容器）
ADMIN_PUBLISH_PORT=8848

DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=iam

# OIDC / SSO（直连 localhost 试用）
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=please-change-me-in-production
BETTER_AUTH_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:3000/oidc
OIDC_COOKIE_KEYS=dev-key-1,dev-key-2
# 显式 RSA JWKS（私钥文件）。生成：pnpm oidc:jwks:generate
# 未挂载密钥文件时请注释下一行，development 会自动生成 secrets/oidc-jwks.json
# OIDC_JWKS_FILE=secrets/oidc-jwks.json
OIDC_SESSION_TTL_SECONDS=2592000
OIDC_ACCESS_TOKEN_TTL_SECONDS=7200
OIDC_REFRESH_TOKEN_TTL_SECONDS=2592000
PORTAL_SESSION_TTL_SECONDS=604800
OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300

# 使用 Nginx 网关 profile 时改为子域（需 hosts + docker compose --profile gateway）
# APP_URL=http://api.pinshuai.local
# BETTER_AUTH_URL=http://api.pinshuai.local
# OIDC_ISSUER=http://auth.pinshuai.local/oidc
# NGINX_PUBLISH_PORT=80

# NAS 多应用：flow-admin :9445 等需跨域访问 IAM OIDC/API 时追加（逗号分隔）
# CORS_ORIGINS=http://192.168.50.100:9445
# docker compose --env-file .env.docker exec iam pnpm seed:oauth-flow-admin
