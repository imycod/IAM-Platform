# ============================================================
# 生产 / 上线环境（NODE_ENV=production）
# 启动：pnpm start:prod
#
# Google 式拓扑：
#   auth.* = IdP（登录 UI + /oidc + interaction）
#   api.*  = 业务 API
#   admin.* / flow.* = 各客户端 SPA
#
# 上线时把 pinshuai.local 换成真实域名，并轮换密钥。
# ============================================================

APP_ENV=production
APP_URL=http://api.pinshuai.local
BETTER_AUTH_URL=http://api.pinshuai.local

# IdP issuer 必须与登录页同源（auth），cookie 才能正确工作
OIDC_ISSUER=http://auth.pinshuai.local/oidc
OIDC_COOKIE_KEYS=change-me-prod-key-1,change-me-prod-key-2
OIDC_SESSION_TTL_SECONDS=1209600

IAM_LOGIN_URL=http://auth.pinshuai.local
IAM_LOGIN_PORT=4180

CORS_ORIGINS=http://auth.pinshuai.local,http://api.pinshuai.local,http://admin.pinshuai.local,http://flow.pinshuai.local

APP_RETURN_URLS={"iam-admin-spa":"http://admin.pinshuai.local/","flow-admin-spa":"http://flow.pinshuai.local/"}
