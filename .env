# ============================================================
# 共享基础配置（所有环境都会先加载本文件，再被 .env.${NODE_ENV} 覆盖）
# ============================================================

# App
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
APP_GLOBAL_PREFIX=api

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_DATABASE=iam

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# better-auth（后续接入）
BETTER_AUTH_SECRET=please-change-me
BETTER_AUTH_URL=http://localhost:3000

# OIDC
OIDC_ISSUER=http://localhost:3000/oidc
OIDC_COOKIE_KEYS=key1,key2
# SSO 会话 TTL（秒），默认 14 天
OIDC_SESSION_TTL_SECONDS=1209600

# 统一登录页（iam-login）；未配置时使用内置简易页
IAM_LOGIN_URL=http://localhost:4180
IAM_LOGIN_PORT=4180

# CORS 允许的前端 Origin（逗号分隔）
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:8089,http://127.0.0.1:8089,http://localhost:4180,http://127.0.0.1:4180,http://localhost:4173,http://127.0.0.1:4173

# 各 OAuth client 拒绝授权 / 会话失效时回跳的应用首页（JSON）
APP_RETURN_URLS={"iam-admin-spa":"http://localhost:8088/","flow-admin-spa":"http://localhost:8089/"}
